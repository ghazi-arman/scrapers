{
    "name": "smuckers-product-scraper",
    "version": "1.0.0",
    "description": "Scrapes Smucker's product pages for ingredients, nutrition, images, and UPCs",
    "type": "module",
    "scripts": {
      "scrape": "npx tsx scrape.ts",
      "scrape:local": "npx tsx scrape.ts --local",
      "scrape:local:limit": "npx tsx scrape.ts --local --limit 5",
      "postinstall": "playwright install"
    },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-ssm": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
      "axios": "^1.6.7",
      "cheerio": "^1.0.0-rc.12",
      "p-limit": "^4.0.0",
      "playwright": "^1.42.0",
      "uuid": "^9.0.0"
    },
    "devDependencies": {
      "@types/node": "^20.0.0",
      "@types/uuid": "^9.0.0",
      "tsx": "^4.19.0",
      "typescript": "^5.5.4"
    },
    "engines": {
      "node": ">=18.0.0"
    },
    "license": "MIT"
  }